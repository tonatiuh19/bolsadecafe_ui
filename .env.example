# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Application
NODE_ENV=development
PORT=8080

# Public site URL — used in emails, Stripe billing portal return URL, and CORS
# Production: https://www.bolsadecafe.com
FRONTEND_URL=http://localhost:8080

# Database (Hostgator MySQL)
DB_HOST=your_hostgator_mysql_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_SSL=false

# Stripe — server (runtime)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe — client (embedded at build time by Vite; must match sk_* mode)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Auth
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
SMTP_FROM=Bolsa de Café <dihola@bolsadecafe.com>

# Optional
PING_MESSAGE=pong
